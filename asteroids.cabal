cabal-version:       3.0
name:                asteroids
version:             0.1.0.0
build-type:          Simple

library
  exposed-modules:     Model, View, Input, Update
  hs-source-dirs:      src
  build-depends:       base >=4.14 && <5,
                       gloss >=1.13 && <2,
                       random >=1.2 && <2
  default-language:    Haskell2010

executable asteroids
  main-is:             Main.hs
  hs-source-dirs:      src
  build-depends:       base >=4.14 && <5,
                       asteroids,
                       gloss >=1.13 && <2,
                       random >=1.2 && <2
  default-language:    Haskell2010
